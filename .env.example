# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Required for live/test Stripe payments (sk_test_... or sk_live_...).
# Get your Secret Key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Required for verifying Stripe webhook signatures (whsec_...).
# Get from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=""

# STRIPE_STANDARD_PRICE_ID: Optional custom Price ID for Standard Plan (150 THB/month).
# If left empty, the system automatically creates the THB 150 line item dynamically.
STRIPE_STANDARD_PRICE_ID=""

# STRIPE_PRO_PRICE_ID: Optional custom Price ID for Pro Plan (299 THB/month).
# If left empty, the system automatically creates the THB 299 line item dynamically.
STRIPE_PRO_PRICE_ID=""
